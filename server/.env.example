# ---- Server ----
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed browser origins (CORS)
CLIENT_ORIGIN=http://localhost:5173

# ---- MongoDB ----
# MongoDB Atlas (recommended — replica set, so transactions are enabled):
#   MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nimba_stay?retryWrites=true&w=majority
# Local standalone MongoDB (works, but runs in non-transactional fallback mode):
MONGO_URI=mongodb://127.0.0.1:27017/nimba_stay

# Separate database used by the automated test suite (wiped between tests!)
MONGO_URI_TEST=mongodb://127.0.0.1:27017/nimba_stay_test
